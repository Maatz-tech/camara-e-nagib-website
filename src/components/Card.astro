---
interface Props {
  title: string;
  description?: string;
  image?: string;
  href?: string;
}

const { title, description, image, href } = Astro.props;
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="p-6">
    {href ? (
      <a href={href} class="block">
        <h3 class="text-xl font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
          {title}
        </h3>
      </a>
    ) : (
      <h3 class="text-xl font-semibold text-gray-900 mb-2">
        {title}
      </h3>
    )}

    {description && (
      <p class="text-gray-600">
        {description}
      </p>
    )}

    <slot />
  </div>
</article>
