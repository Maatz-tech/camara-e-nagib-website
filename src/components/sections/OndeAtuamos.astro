---
import { url } from '../../lib/url';

interface Item {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Onde atuamos', items } = Astro.props;
const resolvedItems = items.map((it) => ({
  ...it,
  icon: it.icon.startsWith('http') ? it.icon : url(it.icon),
}));
---

<section class="w-full border-b border-gold-5 bg-white">
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col gap-10 pt-12 pb-12 md:gap-16 md:pt-20 md:pb-20"
  >
    <h2
      class="px-6 text-center font-normal text-[#2f2019] text-[32px] leading-tight tracking-[-0.8px] md:px-[120px] md:text-[48px] md:tracking-[-1px]"
      data-animate
      data-animate-type="typing"
    >
      {title}
    </h2>

    <div class="relative">
      <div
        class="onde-atuamos-scroller flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 pb-2 scroll-px-6 md:cursor-grab md:px-[120px] md:scroll-px-[120px]"
      >
        {
          resolvedItems.map((item) => (
            <article class="flex w-[327px] shrink-0 snap-start flex-col gap-6 rounded-2xl border border-mute p-6 sm:w-[420px] md:w-[588px]">
              <div class="flex size-12 items-center justify-center rounded-full bg-navy/10">
                <img
                  src={item.icon}
                  alt=""
                  aria-hidden="true"
                  class="size-6"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col gap-3.5">
                <h3 class="text-[18px] font-semibold leading-tight text-[#2f2019] md:text-[20px]">
                  {item.title}
                </h3>
                <p class="text-[15px] font-medium leading-[1.5] text-[#33261d] md:text-[16px]">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Pagination dots -->
    <div
      class="onde-atuamos-dots flex items-center justify-center gap-2"
      data-count={items.length}
    >
      {
        items.map((_, i) => (
          <button
            type="button"
            class="onde-atuamos-dot size-2 rounded-full bg-mute transition-colors data-[active=true]:bg-gold"
            data-index={i}
            aria-label={`Ir para slide ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.onde-atuamos-scroller').forEach(
    (scroller) => {
      const section = scroller.closest('section');
      if (!section) return;
      const dots = section.querySelectorAll<HTMLButtonElement>(
        '.onde-atuamos-dot',
      );
      const articles = scroller.querySelectorAll<HTMLElement>('article');

      const updateDots = () => {
        const center = scroller.scrollLeft + scroller.clientWidth / 2;
        let nearest = 0;
        let nearestDist = Infinity;
        articles.forEach((a, i) => {
          const articleCenter = a.offsetLeft + a.offsetWidth / 2;
          const dist = Math.abs(center - articleCenter);
          if (dist < nearestDist) {
            nearestDist = dist;
            nearest = i;
          }
        });
        dots.forEach((d, i) => {
          d.dataset.active = String(i === nearest);
        });
      };

      scroller.addEventListener('scroll', updateDots, { passive: true });
      window.addEventListener('resize', updateDots);

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = Number(dot.dataset.index);
          const target = articles[idx];
          if (!target) return;
          const padLeft =
            parseFloat(getComputedStyle(scroller).scrollPaddingLeft) || 0;
          scroller.scrollTo({
            left: target.offsetLeft - padLeft,
            behavior: 'smooth',
          });
        });
      });

      // Mouse drag-to-scroll (touch already works natively via overflow scroll).
      let activePointerId: number | null = null;
      let dragStartX = 0;
      let lastClientX = 0;
      let dragMoved = false;
      const DRAG_THRESHOLD = 5;

      const onPointerDown = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        activePointerId = e.pointerId;
        dragMoved = false;
        dragStartX = e.clientX;
        lastClientX = e.clientX;
      };

      const onPointerMove = (e: PointerEvent) => {
        if (activePointerId !== e.pointerId) return;
        const totalDx = e.clientX - dragStartX;
        if (!dragMoved && Math.abs(totalDx) > DRAG_THRESHOLD) {
          dragMoved = true;
          // Capture the pointer so subsequent move/up events still hit us
          // even if the cursor leaves the scroller bounds.
          scroller.setPointerCapture(e.pointerId);
          scroller.classList.add('is-dragging');
          scroller.style.scrollSnapType = 'none';
          // `scroll-smooth` is set on the container; turn it off during drag
          // so each scrollLeft assignment is instantaneous instead of animating.
          scroller.style.scrollBehavior = 'auto';
          // Block native text selection that would otherwise start.
          e.preventDefault();
        }
        if (dragMoved) {
          // Incremental delta — the browser clamps scrollLeft at edges, so
          // tracking absolute (clientX - startX) breaks reversing direction
          // after hitting an edge.
          const dx = e.clientX - lastClientX;
          lastClientX = e.clientX;
          scroller.scrollLeft -= dx;
          e.preventDefault();
        }
      };

      const onPointerUp = (e: PointerEvent) => {
        if (activePointerId !== e.pointerId) return;
        const wasDragging = dragMoved;
        activePointerId = null;
        dragMoved = false;
        scroller.classList.remove('is-dragging');
        scroller.style.scrollSnapType = '';
        scroller.style.scrollBehavior = '';
        if (scroller.hasPointerCapture(e.pointerId)) {
          scroller.releasePointerCapture(e.pointerId);
        }
        if (!wasDragging) return;

        // Suppress the click that fires after a drag. Use { once: true } so
        // a stale handler can't accidentally swallow a future legitimate click.
        scroller.addEventListener(
          'click',
          (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
          },
          { capture: true, once: true },
        );

        // Snap to the nearest card after drag ends.
        const center = scroller.scrollLeft + scroller.clientWidth / 2;
        let nearest: HTMLElement | null = null;
        let nearestDist = Infinity;
        articles.forEach((a) => {
          const articleCenter = a.offsetLeft + a.offsetWidth / 2;
          const dist = Math.abs(center - articleCenter);
          if (dist < nearestDist) {
            nearestDist = dist;
            nearest = a;
          }
        });
        if (nearest) {
          const padLeft =
            parseFloat(getComputedStyle(scroller).scrollPaddingLeft) || 0;
          scroller.scrollTo({
            left: (nearest as HTMLElement).offsetLeft - padLeft,
            behavior: 'smooth',
          });
        }
      };

      scroller.addEventListener('pointerdown', onPointerDown);
      scroller.addEventListener('pointermove', onPointerMove);
      scroller.addEventListener('pointerup', onPointerUp);
      scroller.addEventListener('pointercancel', onPointerUp);
      // Don't react to pointerleave — pointer capture handles that case.

      updateDots();
    },
  );
</script>

<style>
  .onde-atuamos-scroller {
    scrollbar-width: none;
  }
  .onde-atuamos-scroller::-webkit-scrollbar {
    display: none;
  }
  .onde-atuamos-scroller.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .onde-atuamos-scroller.is-dragging * {
    pointer-events: none;
  }
</style>
