---
import { url } from '../../lib/url';

interface Props {
  titleStart: string;
  titleEmphasis: string;
  description: string[];
  /** Single composite image (already includes layout/logo). When provided, replaces the collage. */
  composite?: string;
  /** Used when `composite` is not provided. Builds a 2-photo collage with optional logo overlay. */
  image1?: string;
  image2?: string;
  logo?: string;
}

const {
  titleStart,
  titleEmphasis,
  description,
  composite,
  image1,
  image2,
  logo,
} = Astro.props;

const resolve = (p: string) => (p.startsWith('http') ? p : url(p));
const compositeSrc = composite ? resolve(composite) : undefined;
const image1Src = image1 ? resolve(image1) : undefined;
const image2Src = image2 ? resolve(image2) : undefined;
const logoSrc = logo ? resolve(logo) : undefined;
---

<section class="w-full border-b border-gold-5 bg-white">
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-6 pt-12 pb-12 md:flex-row md:items-start md:gap-16 md:px-[120px] md:pt-20 md:pb-20"
  >
    {
      compositeSrc ? (
        <div class="relative w-full md:max-w-[504px] md:shrink-0 md:self-start">
          <img
            src={compositeSrc}
            alt=""
            aria-hidden="true"
            class="block h-auto w-full"
            loading="lazy"
          />
        </div>
      ) : (
        <>
          <div class="relative aspect-[327/228] w-full overflow-hidden rounded-2xl md:hidden">
            {image1Src && (
              <img
                src={image1Src}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover object-center"
                loading="lazy"
              />
            )}
          </div>

          <div class="relative hidden shrink-0 md:block md:self-start">
            <div class="relative h-[352px] w-[504px]">
              {image1Src && (
                <div class="absolute left-0 top-0 h-[300px] w-[240px] overflow-hidden rounded-2xl">
                  <img
                    src={image1Src}
                    alt=""
                    aria-hidden="true"
                    class="h-full w-full object-cover object-bottom"
                    loading="lazy"
                  />
                </div>
              )}
              {image2Src && (
                <div class="absolute right-0 top-[32px] h-[300px] w-[240px] overflow-hidden rounded-2xl">
                  <img
                    src={image2Src}
                    alt=""
                    aria-hidden="true"
                    class="h-full w-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              )}
              {logoSrc && (
                <div class="absolute left-[212px] top-[272px] flex size-20 items-center justify-center">
                  <img
                    src={logoSrc}
                    alt="Câmara & Nagib"
                    class="h-full w-full"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          </div>
        </>
      )
    }

    <!-- Copy -->
    <div class="flex flex-1 flex-col gap-6">
      <h2
        class="text-[#2f2019] text-[32px] leading-[1.2] tracking-[-0.9px] md:text-[32px] md:tracking-[-1.2px]"
      >
        <span class="font-normal">{titleStart}</span>
        <span
          class="block italic text-gold md:text-[40px]"
          style="font-family: var(--font-serif); font-weight: 500;"
        >
          {titleEmphasis}
        </span>
      </h2>

      <div
        class="flex flex-col gap-4 text-[16px] font-normal leading-[1.6] text-[#2f2019] md:text-[18px]"
      >
        {description.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
