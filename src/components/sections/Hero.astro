---
import Icon from '../Icon.astro';
import { url } from '../../lib/url';

const ctaPrimaryHref = url('/contato');
const ctaSecondaryHref = url('/#atuacoes');
const heroImage = url('/images/hero/hero-image.webp');
---

<section
  id="hero"
  class="relative w-full border-b border-gold-5 bg-[#f9f7f2]"
>
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col items-stretch gap-8 px-6 pt-10 pb-12 md:flex-row md:items-center md:gap-16 md:px-[120px] md:pt-20 md:pb-20"
  >
    <!-- Copy + CTAs (left on desktop) -->
    <div class="flex w-full flex-col items-start md:flex-1">
      <span class="eyebrow eyebrow-pill" data-animate>Consultoria jurídica</span>

      <h1
        class="mt-5 font-medium text-[#2f2019] text-[40px] leading-[52px] tracking-[-1.2px] md:mt-6 md:text-[64px] md:leading-[80px] md:tracking-[-1.5px]"
        data-animate
        data-animate-type="typing"
      >
        Estratégia<br />jurídica para<br /><span
          class="italic text-gold text-[48px] md:text-[72px]"
          style="font-family: var(--font-serif); font-weight: 500;"
        >proteger o que<br />importa</span>
      </h1>

      <p
        class="mt-4 max-w-[576px] text-[16px] font-normal leading-[24px] text-[#33261d] md:mt-6 md:text-[18px] md:leading-[30px]"
        data-animate
        data-animate-delay="200"
      >
        Atuação integrada em Direito de Família, Sucessões e Imobiliário para
        organizar, proteger e estruturar seu patrimônio com clareza e
        segurança.
      </p>

      <!-- Mobile-only image, between paragraph and buttons -->
      <img
        src={heroImage}
        alt="Sócias Ana Carolina Nagib e Rafaela Câmara"
        class="mt-8 h-auto w-full md:hidden"
        width="1164"
        height="1102"
        loading="eager"
        fetchpriority="high"
      />

      <div
        class="mt-8 flex w-full flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-10 md:gap-4"
        data-animate
        data-animate-delay="300"
      >
        <a href={ctaPrimaryHref} class="btn btn-primary btn-md">
          <span>Agendar Consultoria</span>
          <Icon name="arrow-right" size={20} />
        </a>
        <a
          href={ctaSecondaryHref}
          class="btn btn-md inline-flex items-center justify-center rounded-full border border-gold-30 bg-white text-[#2f2019] transition-colors hover:bg-gold-5"
        >
          Nossas Atuações
        </a>
      </div>
    </div>

    <!-- Desktop-only image (right column) -->
    <div class="hidden md:flex md:flex-1 md:justify-end">
      <img
        src={heroImage}
        alt="Sócias Ana Carolina Nagib e Rafaela Câmara"
        class="h-auto w-full max-w-[582px]"
        width="1164"
        height="1102"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
