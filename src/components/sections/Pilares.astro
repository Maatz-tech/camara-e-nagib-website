---
type Pillar = {
  title: string;
  description?: string;
  bullets?: string[];
};

const pillars: Pillar[] = [
  {
    title: 'Missão',
    description:
      'Conduzir decisões jurídicas que protegem patrimônio, antecipando riscos e garantindo segurança e previsibilidade.',
  },
  {
    title: 'Visão',
    description:
      'Atuar como referência em decisões patrimoniais e imobiliárias de alto impacto em Natal/RN.',
  },
  {
    title: 'Valores',
    bullets: [
      'Atuar com estratégia antes do risco.',
      'Clareza e precisão jurídica.',
      'Proteção patrimonial como prioridade.',
    ],
  },
];
---

<section class="w-full border-b border-gold-5 bg-[#f9fafb]">
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col gap-10 pt-12 pb-12 md:gap-16 md:pt-20 md:pb-20"
  >
    <h2
      class="px-6 text-center text-[32px] font-normal leading-tight text-[#2f2019] md:px-[120px] md:text-[48px] md:leading-[48px]"
      data-animate
      data-animate-type="typing"
    >
      Nossos pilares
    </h2>

    <!-- Mobile: horizontal carousel. Desktop: 3-col grid. -->
    <div
      class="pilares-cards flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto px-6 scroll-px-6 pb-2 md:grid md:grid-cols-3 md:overflow-visible md:px-[120px] md:pb-0"
    >
      {
        pillars.map((p, i) => (
          <article
            class="flex w-[300px] shrink-0 snap-start flex-col gap-6 rounded-2xl border border-mute bg-white p-7 md:w-auto md:p-8"
            data-animate
            data-animate-delay={`${(i + 1) * 100}`}
          >
            <h3
              class="italic text-[28px] font-semibold text-navy md:text-[36px]"
              style="font-family: var(--font-serif);"
            >
              {p.title}
            </h3>
            {p.description && (
              <p class="text-[15px] font-medium leading-[1.5] text-[#33261d] md:text-[16px]">
                {p.description}
              </p>
            )}
            {p.bullets && (
              <ul class="flex list-disc flex-col gap-1 pl-6 text-[15px] font-medium leading-[1.5] text-[#33261d] md:text-[16px]">
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pilares-cards {
    scrollbar-width: none;
  }
  .pilares-cards::-webkit-scrollbar {
    display: none;
  }
</style>
