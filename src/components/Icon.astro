---
import { url } from '../lib/url';

interface Props {
  name: string;
  size?: number | string;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
const sizeValue = typeof size === 'number' ? `${size}px` : size;
const iconUrl = url(`/icons/${name}.svg`);
---

<span
  class:list={['icon', className]}
  style={`--icon-url: url(${iconUrl}); --icon-size: ${sizeValue};`}
  aria-hidden="true"
></span>
