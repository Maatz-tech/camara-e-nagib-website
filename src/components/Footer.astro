---
import Icon from './Icon.astro';
import { url } from '../lib/url';

const navigation = [
  { href: url('/'), label: 'Início' },
  { href: url('/sobre'), label: 'Sobre o Escritório' },
  { href: url('/#atuacoes'), label: 'Áreas de Atuação' },
  { href: url('/blog'), label: 'Blog Jurídico' },
  { href: url('/materiais'), label: 'Materiais Gratuitos' },
];

const services = [
  { href: url('/atuacoes/direito-imobiliario'), label: 'Direito Imobiliário' },
  { href: url('/atuacoes/direito-das-familias'), label: 'Direito das Famílias' },
  { href: '#sucessoes', label: 'Direito das Sucessões' },
  { href: '#patrimonial', label: 'Planejamento Patrimonial' },
  { href: '#regularizacao', label: 'Regularização de Imóveis' },
];

const homeHref = url('/');
const logoSrc = url('/images/logo-light.webp');

const contact = {
  address: 'Natal, RN - Brasil',
  phone: '(84) 99999-9999',
  email: 'contato@camaraenagib.adv.br',
};

const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-deep text-white">
  <div class="mx-auto w-full max-w-[1280px] px-6 pt-16 pb-10 md:px-[72px] md:pt-20 md:pb-10">
    <div
      class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1fr_1fr_1fr] md:gap-8"
    >
      <!-- Brand column -->
      <div class="flex flex-col gap-6">
        <a href={homeHref} class="inline-flex" aria-label="Câmara & Nagib — Início">
          <img
            src={logoSrc}
            alt="Câmara & Nagib Advocacia Especializada"
            width="192"
            height="62"
            class="h-[62px] w-auto object-contain"
          />
        </a>
        <p class="text-[14px] font-medium leading-[22px] text-on-dark-60">
          Estratégia antes do risco. Consultoria jurídica de alto impacto para
          proteção patrimonial e investimentos imobiliários.
        </p>
        <div class="flex items-center gap-4">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex size-10 items-center justify-center rounded-full border border-on-dark-10 transition-colors hover:bg-on-dark-10"
          >
            <Icon name="instagram" size={18} />
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex size-10 items-center justify-center rounded-full border border-on-dark-10 transition-colors hover:bg-on-dark-10"
          >
            <Icon name="linkedin" size={18} />
          </a>
        </div>
      </div>

      <!-- Navegação -->
      <div class="flex flex-col gap-6">
        <h2 class="eyebrow">Navegação</h2>
        <ul class="flex flex-col gap-4">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[14px] font-medium leading-5 text-on-dark-70 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Atuação -->
      <div class="flex flex-col gap-6">
        <h2 class="eyebrow">Atuação</h2>
        <ul class="flex flex-col gap-4">
          {
            services.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[14px] font-medium leading-5 text-on-dark-70 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contato -->
      <div class="flex flex-col gap-6">
        <h2 class="eyebrow">Contato</h2>
        <address class="not-italic">
          <ul class="flex flex-col gap-4 text-[14px] font-medium leading-5 text-on-dark-70">
            <li class="flex items-start gap-3">
              <Icon name="map-pin" size={18} class="mt-0.5" />
              <span>{contact.address}</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="phone" size={18} class="mt-0.5" />
              <a href={`tel:${contact.phone.replace(/\D/g, '')}`} class="hover:text-white transition-colors">
                {contact.phone}
              </a>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="mail" size={18} class="mt-0.5" />
              <a href={`mailto:${contact.email}`} class="hover:text-white transition-colors break-all">
                {contact.email}
              </a>
            </li>
          </ul>
        </address>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-16 flex flex-col items-center gap-4 border-t border-on-dark-10 pt-8 text-[12px] font-medium leading-4 text-on-dark-40 md:flex-row md:justify-between md:gap-0"
    >
      <p class="text-center md:text-left">
        © {currentYear} Câmara & Nagib Advogados Associados. Todos os direitos
        reservados.
      </p>
      <ul class="flex items-center gap-6">
        <li>
          <a href="#privacidade" class="transition-colors hover:text-white">
            Privacidade
          </a>
        </li>
        <li>
          <a href="#termos" class="transition-colors hover:text-white">
            Termos de Uso
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
