---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Trajetoria from '../components/sections/Trajetoria.astro';
import Pilares from '../components/sections/Pilares.astro';
import Fundadoras from '../components/sections/Fundadoras.astro';
import Depoimentos from '../components/sections/Depoimentos.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://camaraenagib.adv.br/' },
    { '@type': 'ListItem', position: 2, name: 'Sobre Nós', item: 'https://camaraenagib.adv.br/sobre' },
  ],
};
---

<Base
  title="Sobre Nós | Câmara & Nagib Advogados Associados"
  description="Conheça a Câmara & Nagib — escritório fundado por Ana Carolina Nagib e Rafaela Câmara, com foco em proteção patrimonial, Direito Imobiliário e Direito de Família."
  jsonLd={jsonLd}
>
  <Header />

  <main id="main-content">
    <PageHeader
      eyebrow="sobre nós"
      watermark="/images/sobre/page-header-watermark.svg"
    >
      <h1
        slot="title"
        class="text-[#2f2019] text-[36px] font-medium leading-[1.15] tracking-[-1px] md:text-[48px] md:leading-[60px] md:tracking-[-1.5px]"
      >
        Unimos
        <span
          class="italic text-gold"
          style="font-family: var(--font-serif); font-weight: 500;"
        >
          estratégia
        </span>
        <span class="italic">e</span>
        <span
          class="italic text-gold"
          style="font-family: var(--font-serif); font-weight: 500;"
        >
          técnica
        </span>
        para garantir segurança em grandes decisões
      </h1>
    </PageHeader>

    <Trajetoria />
    <Pilares />
    <Fundadoras />
    <Depoimentos />
    <CtaFinal />
  </main>

  <Footer />
</Base>
